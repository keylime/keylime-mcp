# Keylime MCP Server Configuration

# Keylime API endpoints
KEYLIME_VERIFIER_URL=https://localhost:8881
KEYLIME_REGISTRAR_URL=https://localhost:8891
KEYLIME_API_VERSION=v2.5

# TLS configuration
KEYLIME_TLS_ENABLED=true
KEYLIME_TLS_SERVER_NAME=localhost

# Certificate paths
KEYLIME_CERT_DIR=/var/lib/keylime/cv_ca

# LLM providers — set a cloud API key or configure local Ollama
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# Optional replacement for OpenAI's default model filter (Chat Completions + tools only)
# OPENAI_MODEL_FILTER_REGEX=^(gpt-4o|gpt-4-turbo)$
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=

# Mask sensitive data before sending to LLM (default: true)
MASKING_ENABLED=true

# Web UI port (client only)
PORT=3000
